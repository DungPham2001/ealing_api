NODE_ENV=development
PORT=4000
# Same Atlas cluster as the other apps, one database per app: ealing_holdings
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/ealing_holdings?retryWrites=true&w=majority
CORS_ORIGINS=
TIMEZONE=America/New_York
# Optional: when set, /v1/jobs/daily requires "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it automatically)
CRON_SECRET=
# Per-IP limits (spec 2.8). RATE_LIMIT=off disables them.
RATE_READ_PER_MIN=60
RATE_WRITE_PER_MIN=20
RATE_CREATE_PER_DAY=300
RATE_EXPORT_PER_DAY=30
